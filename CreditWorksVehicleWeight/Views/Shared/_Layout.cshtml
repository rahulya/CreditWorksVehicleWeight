<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · CreditWorks Fleet</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="topbar">
        <a class="brand" asp-controller="Vehicles" asp-action="Index"><span class="brand-mark">CW</span><span>CreditWorks <small>FLEET CONSOLE</small></span></a>
        <nav aria-label="Main navigation">
            <a asp-controller="Vehicles" asp-action="Index">Vehicles</a>
            <a asp-controller="Categories" asp-action="Index">Categories</a>
        </nav>
    </header>
    <main class="container">
        @if (TempData["Success"] is string success) { <div class="notice success" role="status">@success</div> }
        @RenderBody()
    </main>
    <footer>CreditWorks · Vehicle administration assignment</footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
