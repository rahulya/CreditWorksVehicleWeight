@model VehicleFormViewModel
@{ ViewData["Title"] = "Add vehicle"; }
<div class="form-shell">
    <a class="back-link" asp-action="Index">← Back to vehicles</a>
    <div class="form-heading"><p class="eyebrow">FLEET RECORD</p><h1>Add vehicle</h1><p class="muted">Enter the vehicle details. Its category is assigned automatically from its weight.</p></div>
    <form asp-action="Create" method="post" class="panel form-panel">
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
        <div class="field"><label asp-for="OwnerName"></label><input asp-for="OwnerName" placeholder="e.g. Jordan Smith" autocomplete="name"/><span asp-validation-for="OwnerName"></span></div>
        <div class="field"><label asp-for="ManufacturerId"></label><select asp-for="ManufacturerId" asp-items="Model.Manufacturers"><option value="">Select manufacturer</option></select><span asp-validation-for="ManufacturerId"></span></div>
        <div class="field-grid">
            <div class="field"><label asp-for="YearOfManufacture"></label><input asp-for="YearOfManufacture" type="number" min="1886" max="2100"/><span asp-validation-for="YearOfManufacture"></span></div>
            <div class="field"><label asp-for="WeightKg"></label><div class="input-suffix"><input asp-for="WeightKg" type="number" min="0.01" step="0.01" placeholder="e.g. 1850.75"/><span>kg</span></div><span asp-validation-for="WeightKg"></span></div>
        </div>
        <div class="form-actions"><a class="button secondary" asp-action="Index">Cancel</a><button class="button primary" type="submit">Save vehicle</button></div>
    </form>
</div>
